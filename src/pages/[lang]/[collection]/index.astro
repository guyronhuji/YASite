---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type SupportedCollection = "research" | "activism" | "outreach" | "services" | "publications";

// Shared data shape for common collections (research, activism, outreach, services)
interface CommonData {
    title: string;
    description?: string;
    date?: Date;
    order?: number;
    image?: string;
    backgroundImage?: string;
    openLinksInNewTab?: boolean;
    backgroundColor?: string;
}

// Shape used only for sorting (covers both common and publications schemas)
interface SortableData {
    order?: number;
    date?: Date;
    year?: number;
}

export async function getStaticPaths() {
    const collections: SupportedCollection[] = [
        "research",
        "activism",
        "outreach",
        "services",
        "publications",
    ];
    const langs = ["en", "he", "ar"];

    const paths = [];
    for (const lang of langs) {
        for (const collection of collections) {
            paths.push({ params: { lang, collection } });
        }
    }
    return paths;
}

const { lang, collection } = Astro.params;
const col = collection as SupportedCollection;

// Get items — typed as the union of all supported collection entries
const allItems = await getCollection(col, (entry) => {
    const { id } = entry;
    if (col === "publications") return id.startsWith("en/");
    return id.startsWith(lang + "/");
});

// Find the index entry for this section
const introEntryIndex = allItems.findIndex(
    (item) =>
        item.id === `${lang}/index.md` ||
        item.slug === lang ||
        item.slug === `${lang}/index`,
);
let sectionIntro: (typeof allItems)[0] | null = null;
if (introEntryIndex !== -1) {
    sectionIntro = allItems[introEntryIndex];
    allItems.splice(introEntryIndex, 1);
}

// Sort items — access only fields present in both schemas via SortableData
allItems.sort((a, b) => {
    const aData = a.data as SortableData;
    const bData = b.data as SortableData;
    const orderA = aData.order ?? 9999;
    const orderB = bData.order ?? 9999;
    if (orderA !== orderB) return orderA - orderB;
    const dateA = aData.date ? aData.date.getTime() : aData.year ?? 0;
    const dateB = bData.date ? bData.date.getTime() : bData.year ?? 0;
    return dateB - dateA;
});

// Group publications by year (descending)
const pubsByYear: Record<string, CollectionEntry<"publications">[]> = {};
const sortedPubYears: string[] = [];
if (col === "publications") {
    for (const item of allItems as CollectionEntry<"publications">[]) {
        const year = String(item.data.year ?? "");
        if (!pubsByYear[year]) pubsByYear[year] = [];
        pubsByYear[year].push(item);
    }
    sortedPubYears.push(
        ...Object.keys(pubsByYear).sort((a, b) => Number(b) - Number(a))
    );
}

const IntroContent = sectionIntro ? (await sectionIntro.render()).Content : null;

const titleMap: Record<string, Record<string, string>> = {
    en: { research: "Research", activism: "Activism", outreach: "Outreach and Public Engagement", services: "Services", publications: "Publications" },
    he: { research: "מחקר", activism: "אקטיביזם", outreach: "מעורבות ציבורית", services: "שירותי מחקר", publications: "פרסומים" },
    ar: { research: "الأبحاث", activism: "النشاط", outreach: "التوعية", services: "الخدمات", publications: "المنشورات" },
};

const noContentLabel = lang === "he" ? "לא נמצא תוכן." : lang === "ar" ? "لا يوجد محتوى." : "No content found.";
const readMoreLabel = lang === "he" ? "קרא עוד" : lang === "ar" ? "اقرأ المزيد" : "Read more";
const viewPaperLabel = lang === "he" ? "צפייה במאמר" : lang === "ar" ? "عرض الورقة" : "View paper";

const sectionData = sectionIntro?.data as CommonData | undefined;
const pageTitle = sectionData?.title ?? titleMap[lang]?.[col] ?? col;

function getCleanSlug(slug: string) {
    const parts = slug.split("/");
    return parts.length > 1 ? parts.slice(1).join("/") : slug;
}

type DisplayNode =
    | { type: "folder"; title: string; link: string; image?: string }
    | { type: "file"; item: (typeof allItems)[0]; link: string };
---

<Layout
    title={pageTitle}
    lang={lang}
    backgroundImage={sectionData?.backgroundImage}
    openLinksInNewTab={sectionData?.openLinksInNewTab}
>
    <main class="py-12 px-4 sm:px-6 lg:px-8">
        <div class="border-b border-gray-200 mb-8 pb-4">
            <h1 class="text-3xl font-extrabold text-[#000040] font-serif">{pageTitle}</h1>
            {IntroContent && (
                <div
                    class={`mt-4 prose prose-indigo text-base-content max-w-none ${col === "services" ? "prose-lg text-gray-800 mx-auto lg:max-w-none leading-[1.75] p-8 rounded-xl shadow-sm" : ""}`}
                    style={col === "services" ? `background-color: ${sectionData?.backgroundColor ?? "#dde4ef"};` : ""}
                >
                    <IntroContent />
                </div>
            )}
        </div>

        {/* Publications: year-grouped bibliography */}
        {col === "publications" && (
            <div class="space-y-10 max-w-3xl">
                {sortedPubYears.map(year => (
                    <div>
                        <div class="flex items-center gap-4 mb-5">
                            <span class="text-xl font-bold text-[#000040] font-serif w-14 shrink-0 tabular-nums">{year}</span>
                            <div class="flex-1 h-px bg-gray-200" />
                        </div>
                        <div class="space-y-5 ps-[4.5rem]">
                            {pubsByYear[year].map((item) => (
                                <div class="pb-5 border-b border-gray-100 last:border-0">
                                    <h2 class="text-base font-semibold text-[#000040] font-serif leading-snug">
                                        {item.data.url ? (
                                            <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                                                {item.data.title}
                                            </a>
                                        ) : (
                                            item.data.title
                                        )}
                                    </h2>
                                    <p class="mt-1 text-sm text-gray-500">
                                        {item.data.authors?.join(", ")}
                                        {item.data.venue && <span class="italic"> &middot; {item.data.venue}</span>}
                                    </p>
                                    {item.data.url && (
                                        <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-xs font-medium text-indigo-600 hover:text-indigo-500 gap-1">
                                            {viewPaperLabel}
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        )}

        {/* All other collections: card grid */}
        {col !== "publications" && (
            <div class={`grid gap-8 ${col === "services" ? "hidden" : "lg:grid-cols-3 sm:grid-cols-2"}`}>
                {allItems.length === 0 && (
                    <p class="text-gray-500 italic col-span-full">{noContentLabel}</p>
                )}

                {(() => {
                    const displayedItems: DisplayNode[] = [];
                    const processedFolders = new Set<string>();
                    const folderMetadata = new Map<string, (typeof allItems)[0]>();

                    for (const item of allItems) {
                        if (item.id.endsWith("/index.md")) {
                            const cleanSlug = getCleanSlug(item.slug);
                            const folderName = cleanSlug.endsWith("/index")
                                ? cleanSlug.replace(/\/index$/, "")
                                : cleanSlug;
                            folderMetadata.set(folderName, item);
                        }
                    }

                    for (const item of allItems) {
                        const cleanSlug = getCleanSlug(item.slug);
                        const parts = cleanSlug.split("/");
                        const isIndexFile = item.id.endsWith("/index.md");

                        let folderName: string | null = null;
                        if (parts.length > 1) {
                            folderName = parts[0];
                        } else if (isIndexFile) {
                            folderName = cleanSlug.endsWith("/index")
                                ? cleanSlug.replace(/\/index$/, "")
                                : cleanSlug;
                        }

                        if (folderName) {
                            if (!processedFolders.has(folderName)) {
                                processedFolders.add(folderName);
                                const fi = folderMetadata.get(folderName);
                                const fiData = fi?.data as CommonData | undefined;
                                const folderTitle = (fiData?.title && fiData.title.toLowerCase() !== "index")
                                    ? fiData.title
                                    : folderName.charAt(0).toUpperCase() + folderName.slice(1).replace(/-/g, " ");
                                displayedItems.push({
                                    type: "folder",
                                    title: folderTitle,
                                    link: `/${lang}/${col}/${folderName}`,
                                    image: fiData?.image ?? fiData?.backgroundImage,
                                });
                            }
                            if (isIndexFile) continue;
                        } else {
                            displayedItems.push({ type: "file", item, link: `/${lang}/${col}/${cleanSlug}` });
                        }
                    }

                    return displayedItems.map((node) => {
                        if (node.type === "folder") {
                            return (
                                <a href={node.link} class={`group block bg-gray-50 border border-gray-200 rounded-lg hover:bg-white hover:shadow-lg transition-all duration-300 overflow-hidden ${node.image ? "p-0" : "p-6"}`}>
                                    {node.image ? (
                                        <div class="aspect-w-16 aspect-h-9 bg-gray-100 group-hover:opacity-95 transition-opacity">
                                            <img src={node.image} alt={node.title} class="w-full h-48 object-cover" />
                                            <div class="p-6">
                                                <h2 class="text-xl font-bold font-serif text-[#000040]">{node.title}</h2>
                                            </div>
                                        </div>
                                    ) : (
                                        <div class="flex items-center text-[#000040]">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 me-4 text-indigo-300 group-hover:text-indigo-500 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                                            </svg>
                                            <h2 class="text-xl font-bold font-serif">{node.title}</h2>
                                        </div>
                                    )}
                                </a>
                            );
                        }

                        const { item, link } = node;
                        const d = item.data as CommonData;

                        return (
                            <article class="bg-white transition-all duration-300 rounded-lg group shadow-sm hover:shadow-xl hover:-translate-y-1 border border-gray-100 overflow-hidden flex flex-col">
                                <a href={link} class="block overflow-hidden relative">
                                    {d.image ? (
                                        <div class="aspect-w-16 aspect-h-9 bg-gray-100 group-hover:opacity-95 transition-opacity">
                                            <img src={d.image} alt={d.title} class="w-full h-48 object-cover" />
                                        </div>
                                    ) : (
                                        <div class="h-48 bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center text-slate-300 border-b border-gray-100 group-hover:bg-slate-100 transition-colors">
                                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                        </div>
                                    )}
                                </a>
                                <div class="p-6 flex flex-col flex-grow">
                                    <h2 class="text-xl font-bold text-[#000040] mb-2 font-serif">
                                        <a href={link}>{d.title}</a>
                                    </h2>
                                    {(() => {
                                        const summary = d.description ?? (item.body ? item.body.substring(0, 100) + "..." : null);
                                        return summary ? (
                                            <p class="text-gray-600 mb-4 line-clamp-3 text-lg flex-grow leading-relaxed">{summary}</p>
                                        ) : null;
                                    })()}
                                    <div class="mt-auto pt-4 border-t border-gray-50 flex justify-between items-center text-sm">
                                        <a href={link} class="text-indigo-600 font-medium hover:text-indigo-500">{readMoreLabel}</a>
                                        <span class="text-gray-300">&rarr;</span>
                                    </div>
                                </div>
                            </article>
                        );
                    });
                })()}
            </div>
        )}
    </main>
</Layout>
