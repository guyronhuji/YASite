---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'he' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const cvItems = await getCollection('cv', ({ id }) => id.startsWith(lang + '/'));
const cvItem = cvItems[0];

const { Content } = cvItem ? await cvItem.render() : { Content: null };
const title = cvItem?.data.title || "Curriculum Vitae";

// Sections for the "On this page" nav — must match h2 ids generated by markdown
const sections = [
  { id: "education", label: lang === "he" ? "השכלה" : lang === "ar" ? "التعليم" : "Education" },
  { id: "academic-appointments", label: lang === "he" ? "מינויים אקדמיים" : lang === "ar" ? "التعيينات الأكاديمية" : "Academic Appointments" },
  { id: "research-projects", label: lang === "he" ? "פרויקטי מחקר" : lang === "ar" ? "مشاريع البحث" : "Research Projects" },
  { id: "research-grants--fellowships", label: lang === "he" ? "מלגות ומענקים" : lang === "ar" ? "المنح والزمالات" : "Grants & Fellowships" },
  { id: "honors--awards", label: lang === "he" ? "הצטיינות" : lang === "ar" ? "الجوائز" : "Honors & Awards" },
  { id: "teaching-experience", label: lang === "he" ? "הוראה" : lang === "ar" ? "التدريس" : "Teaching" },
  { id: "academic--professional-service", label: lang === "he" ? "שירות מקצועי" : lang === "ar" ? "الخدمة المهنية" : "Service" },
  { id: "non-academic-positions", label: lang === "he" ? "תפקידים לא אקדמיים" : lang === "ar" ? "المناصب غير الأكاديمية" : "Non-Academic" },
  { id: "languages", label: lang === "he" ? "שפות" : lang === "ar" ? "اللغات" : "Languages" },
];
---

<Layout title={title} lang={lang} backgroundImage={cvItem?.data.backgroundImage} backgroundOpacity={0.22}>
  <main class="py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">

      <!-- Page title -->
      <h1 class="text-4xl font-bold text-[#000040] mb-8 pb-4 border-b-2 border-[#000040]/20">
        {title}
      </h1>

      <div class="flex gap-10 items-start">

        <!-- On this page nav — hidden on small screens -->
        <aside class="hidden xl:block w-48 shrink-0 sticky top-8 self-start">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#000040]/50 mb-3">
            {lang === "he" ? "בעמוד זה" : lang === "ar" ? "في هذه الصفحة" : "On this page"}
          </p>
          <nav class="flex flex-col gap-1">
            {sections.map(s => (
              <a
                href={`#${s.id}`}
                class="text-sm text-[#000040]/60 hover:text-[#000040] hover:border-l-2 hover:border-[#97B4D6] pl-2 transition-all duration-150 leading-snug"
              >
                {s.label}
              </a>
            ))}
          </nav>
        </aside>

        <!-- CV content -->
        <div class="min-w-0 flex-1 prose prose-lg max-w-none text-gray-800 font-serif leading-[1.75]
            prose-headings:font-serif prose-headings:text-gray-900
            prose-h2:text-2xl prose-h2:font-bold prose-h2:border-l-4 prose-h2:border-[#97B4D6] prose-h2:pl-3 prose-h2:py-1 prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-[#000040] prose-h2:not-italic
            prose-h3:text-lg prose-h3:font-semibold prose-h3:mt-6 prose-h3:mb-2 prose-h3:text-gray-700
            prose-p:leading-[1.75]
            prose-a:text-indigo-600 prose-a:no-underline hover:prose-a:underline
            prose-hr:border-gray-200 prose-hr:my-6
            prose-li:my-0.5">
          {Content ? <Content /> : <p>CV content not available yet.</p>}
        </div>

      </div>
    </div>
  </main>
</Layout>
